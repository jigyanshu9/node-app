pipeline {
    agent any

    environment {
        IMAGE_NAME     = 'node-app'
        IMAGE_TAG      = "${BUILD_NUMBER}"
        CONTAINER_NAME = 'node-app'
        HOST_PORT      = '3000'
        APP_PORT       = '3000'

        // CHANGE THIS to your real Docker Hub username
        DOCKERHUB_USER = 'jigynashu9'
    }

    options {
        timestamps()
        disableConcurrentBuilds()   // two quick commits won't fight over the same container/port
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
    }

    triggers {
        // 1) Instant trigger when GitHub sends a push webhook
        githubPush()
        // 2) Safety net: if the webhook ever fails, Jenkins still notices new commits within ~2 minutes
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest .'
            }
        }

        stage('Test') {
            steps {
                sh '''
                    docker run --rm ${IMAGE_NAME}:${IMAGE_TAG} \
                        sh -c "node --check server.js && test -f public/index.html"
                '''
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                  usernameVariable: 'DH_USER',
                                                  passwordVariable: 'DH_PASS')]) {
                    sh '''
                        echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${DOCKERHUB_USER}/${IMAGE_NAME}:latest
                        docker push ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${DOCKERHUB_USER}/${IMAGE_NAME}:latest
                        docker logout
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true
                    docker run -d --name ${CONTAINER_NAME} \
                        --restart unless-stopped \
                        -p ${HOST_PORT}:${APP_PORT} \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Smoke Check') {
            steps {
                sh '''
                    sleep 5
                    curl -fsS http://localhost:${HOST_PORT}/ > /dev/null
                '''
            }
        }
    }

    post {
        success {
            echo "Pushed ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG} and deployed. Open http://<ec2-public-ip>:${HOST_PORT}"
        }
        failure {
            echo 'Pipeline failed. Check the stage logs above.'
            sh 'docker logs ${CONTAINER_NAME} || true'
        }
    }
}


